{
  "enabled": true,
  "name": "Warn on API keys and phone numbers",
  "description": "On save of any file, warn if it contains a hard-coded API key or a real phone number.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["**/*"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A file was just saved. If it is inside node_modules, .next, build, dist, test-results, playwright-report or .git, or is a lockfile or binary, reply 'skipped' and stop. Otherwise scan only the saved file. Look for (a) hard-coded API keys or secrets, such as Google keys matching AIza[0-9A-Za-z_-]{35}, sk-... style keys, bearer tokens, or a value assigned to a *_KEY, *_TOKEN or *_SECRET name (empty values in .env.example are fine), and (b) real-looking phone numbers, such as Pakistani mobiles (+92 3xx..., 92 3xx..., 03xx-xxxxxxx) and other E.164 numbers. These are allowed and must not be flagged: the fictional +999 numbers (country code 999 is unassigned), masked numbers that show only the last 3 digits, the fixed fake key FAKE-crypt-test-key-not-a-real-key-0001, and fixture numbers inside *.test.* files or src/test/** that exist to test masking. Do not edit the file. If you find something, reply with a short warning listing file:line and what was found, and suggest moving secrets to .env (gitignored) and replacing phone numbers with a +999 fictional number or a masked form. If nothing is found, reply 'clean' in one word."
  }
}
