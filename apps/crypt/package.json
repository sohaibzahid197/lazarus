{
  "name": "@lazarus/crypt",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run lint && next build --webpack",
    "start": "next start",
    "test": "vitest --run",
    "test:bundle": "GEMINI_API_KEY=${CRYPT_TEST_KEY:-FAKE-crypt-test-key-not-a-real-key-0001} next build --webpack && vitest --run --config vitest.bundle.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "e2e": "npm run test:bundle && playwright test"
  },
  "dependencies": {
    "@lazarus/brain": "*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
